{
  "_note": "Portable KADID-10k config. Set RRCL_KADID_ROOT to the extracted directory containing images/ and dmos.csv.",
  "domains": [
    {
      "name": "KADID-Noise",
      "kind": "csv",
      "root": "${RRCL_KADID_ROOT}/images",
      "csv":  "${RRCL_KADID_ROOT}/dmos.csv",
      "img_col": "dist_img", "mos_col": "dmos",
      "filter_col": "dist_type", "filter_val": "1,2,3,4,5",
      "group_col": "ref_img", "train_ratio": 0.8, "split_seed": 42
    },
    {
      "name": "KADID-Blur",
      "kind": "csv",
      "root": "${RRCL_KADID_ROOT}/images",
      "csv":  "${RRCL_KADID_ROOT}/dmos.csv",
      "img_col": "dist_img", "mos_col": "dmos",
      "filter_col": "dist_type", "filter_val": "6,7,8,9,10",
      "group_col": "ref_img", "train_ratio": 0.8, "split_seed": 42
    },
    {
      "name": "KADID-Color",
      "kind": "csv",
      "root": "${RRCL_KADID_ROOT}/images",
      "csv":  "${RRCL_KADID_ROOT}/dmos.csv",
      "img_col": "dist_img", "mos_col": "dmos",
      "filter_col": "dist_type", "filter_val": "11,12,13,14,15",
      "group_col": "ref_img", "train_ratio": 0.8, "split_seed": 42
    },
    {
      "name": "KADID-Compression",
      "kind": "csv",
      "root": "${RRCL_KADID_ROOT}/images",
      "csv":  "${RRCL_KADID_ROOT}/dmos.csv",
      "img_col": "dist_img", "mos_col": "dmos",
      "filter_col": "dist_type", "filter_val": "16,17,18,19,20",
      "group_col": "ref_img", "train_ratio": 0.8, "split_seed": 42
    },
    {
      "name": "KADID-Spatial",
      "kind": "csv",
      "root": "${RRCL_KADID_ROOT}/images",
      "csv":  "${RRCL_KADID_ROOT}/dmos.csv",
      "img_col": "dist_img", "mos_col": "dmos",
      "filter_col": "dist_type", "filter_val": "21,22,23,24,25",
      "group_col": "ref_img", "train_ratio": 0.8, "split_seed": 42
    }
  ]
}
